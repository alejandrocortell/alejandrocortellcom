---
import "./styles.css";
import { getLangFromUrl, useTranslations } from "@/i18n/i18n";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<section class="container-experience">
  <div class="experience">
    <img
      class="company"
      loading="lazy"
      src={"/assets/img/Touchpix.png"}
      alt={"Touchpix"}
    />
    <div class="col">
      <h2 class="title">{t("touchpix-title")}</h2>
      <p class="time">{t("touchpix-time")}</p>
      <div class="description" set:html={t("touchpix-description")} />
    </div>
  </div>
  <div class="experience">
    <img
      class="company"
      loading="lazy"
      src={"/assets/img/Tecdam.svg"}
      alt={"Tecdam"}
    />
    <div class="col">
      <h2 class="title">{t("tecdam-title")}</h2>
      <p class="time">{t("tecdam-time")}</p>
      <div class="description" set:html={t("tecdam-description")} />
    </div>
  </div>
</section>
