---
import "./styles.css";
import { getLangFromUrl, useTranslations } from "@/i18n/i18n";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<section class="container-knowledge">
  <div class="group-knowledge">
    <h3>{t("kn-frontend")}</h3>
    <div set:html={t("tools-frontend")} />
  </div>
  <div class="group-knowledge">
    <h3>{t("kn-backend")}</h3>
    <div set:html={t("tools-backend")} />
  </div>
  <div class="group-knowledge">
    <h3>{t("kn-mobile")}</h3>
    <div set:html={t("tools-mobile")} />
  </div>
  <div class="group-knowledge">
    <h3>{t("kn-tools")}</h3>
    <div set:html={t("tools-tools")} />
  </div>
</section>
