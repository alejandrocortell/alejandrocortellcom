---
import "./styles.css";
import { getLangFromUrl } from "@/i18n/i18n";

const lang = getLangFromUrl(Astro.url);
---

<nav class="language-selector-container">
  <ul class="language-selector">
    <li>
      <a class=`language ${lang === 'es' ? 'selected' : ''}` href="/es">es</a>
    </li>
    <li>
      <a class=`language ${lang === 'en' ? 'selected' : ''}` href="/">en</a>
    </li>
  </ul>
</nav>
