---
import "./styles.css";

import { getLangFromUrl, useTranslations } from "@/i18n/i18n";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<header class="header">
  <div class="wrapper">
    <h1 class="name" set:html={t("title")} />
    <h2 class="badge">{t("title-badge")}</h2>
    <p class="subtitle" set:html={t("subtitle")} />
    <ul class="contact-list">
      <li class="contact">
        <a
          href="https://www.linkedin.com/in/alejandrocortell/"
          target="_blank"
          class="link"
        >
          <img src="/assets/img/in.svg" alt="Linkedin" class="img" />
        </a>
      </li>
    </ul>
  </div>
</header>
