---
import "./styles.css";

import { getLangFromUrl, useTranslations } from "@/i18n/i18n";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<header class="header">
  <div class="wrapper">
    <h1 class="name" set:html={t("title")} />
    <h2 class="badge">{t("title-badge")}</h2>
    <p class="subtitle" set:html={t("subtitle")} />
    <a
      href="https://www.linkedin.com/in/alejandrocortell/"
      target="_blank"
      class="link"
    >
      <img src="/assets/img/linkedin.svg" alt="Linkedin" class="img" />
      {t("cta")}
    </a>
  </div>
</header>
